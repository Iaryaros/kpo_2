<Project Sdk="Microsoft.NET.Sdk">

  <!-- Single-project layout (08-ddd style): one console app with folder-layers
       Application / Domain / Infrastructure / Presentation. Layers are separated
       by folder and namespace (POS.Domain.Models, POS.Application.Services, ...),
       not by separate projects, so there is a single csproj and a single dotnet build.
       Infrastructure adapters are `internal sealed` and are reached only through
       ports; InternalsVisibleTo lets the POS.Tests assembly construct them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>POS</RootNamespace>
    <AssemblyName>POS</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="POS.Tests" />
  </ItemGroup>

</Project>